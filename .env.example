# ─── Required ─────────────────────────────────────────────────────────────────
DATABASE_URL=mysql://user:password@localhost:3306/bot_boss
JWT_SECRET=generate-with-openssl-rand-hex-32
ENCRYPTION_KEY=generate-with-openssl-rand-hex-32
APPLE_CLIENT_ID=com.botboss.BotBoss
FORGE_API_URL=https://api.openai.com
FORGE_API_KEY=sk-...
PUBLIC_BASE_URL=https://api.botboss.app

# ─── Optional ─────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
ALLOWED_ORIGINS=https://app.botboss.app,https://botboss.app

DAILY_RUN_QUOTA_FREE=50
DAILY_RUN_QUOTA_PRO=2500

# ─── APNs push (for run-complete notifications) ──────────────────────────────
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APNS_ENVIRONMENT=sandbox

# ─── OAuth client credentials ────────────────────────────────────────────────
# Shopify — partner app client id/secret. Required by the Shopify Clerk bot.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Etsy — keystring + shared secret from developers.etsy.com. Required by
# the Etsy Shopkeeper bot. Keystring is used as `x-api-key` on Etsy v3 calls.
ETSY_KEYSTRING=
ETSY_SHARED_SECRET=

# Pinterest — OAuth app client id/secret. Required by the Pinterest Pin Bot.
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
