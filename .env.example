# ─── Beast Bots — Environment Configuration ──────────────────────────────────
#
# Copy this file to `.env` and fill in the values you need. Any OAuth provider
# whose CLIENT_ID / CLIENT_SECRET are missing will simply be disabled in the
# Settings UI — the server will not crash.
#
# Everything above the "Providers" section is required for the app to boot.

# ─── Core ────────────────────────────────────────────────────────────────────

# 64+ hex characters used to derive the AES-256-GCM key that encrypts OAuth
# tokens at rest. Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# HMAC secret for Manus session cookies.
JWT_SECRET=

# MySQL connection string used by Drizzle.
# Example: mysql://user:pass@host:3306/beast_bots
DATABASE_URL=

# Public origin of the deployed app. Used to build OAuth callback URLs.
# Example (dev): http://localhost:5173
# Example (prod): https://beastbots.example.com
PUBLIC_APP_URL=

# ─── Manus SDK (built-in LLM gateway + auth) ─────────────────────────────────

VITE_APP_ID=
OAUTH_SERVER_URL=
OWNER_OPEN_ID=

# LLM gateway credentials — the tool-use loop calls this endpoint with an
# OpenAI-compatible payload targeting gemini-2.5-flash.
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# ─── OAuth Providers ─────────────────────────────────────────────────────────
#
# Register an OAuth app with each provider and set the redirect URI to:
#   ${PUBLIC_APP_URL}/api/connect/${provider_id}/callback
#
# Leave a pair blank to disable that provider in the Settings UI.

# GitHub — https://github.com/settings/developers
# Redirect: ${PUBLIC_APP_URL}/api/connect/github/callback
# Scopes:   repo, read:user, user:email
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google — https://console.cloud.google.com/apis/credentials
# Redirect: ${PUBLIC_APP_URL}/api/connect/google/callback
# Scopes:   openid, email, profile, gmail.modify, calendar, drive.file
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Slack — https://api.slack.com/apps
# Redirect: ${PUBLIC_APP_URL}/api/connect/slack/callback
# Bot scopes: channels:read, chat:write, users:read, groups:read
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# Notion — https://www.notion.so/my-integrations (public integration)
# Redirect: ${PUBLIC_APP_URL}/api/connect/notion/callback
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=

# Linear — https://linear.app/settings/api/applications
# Redirect: ${PUBLIC_APP_URL}/api/connect/linear/callback
# Scopes: read, write, issues:create
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=

# Discord — https://discord.com/developers/applications
# Redirect: ${PUBLIC_APP_URL}/api/connect/discord/callback
# Scopes: identify, guilds, bot
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Figma — https://www.figma.com/developers/apps
# Redirect: ${PUBLIC_APP_URL}/api/connect/figma/callback
# Scopes: file_read
FIGMA_CLIENT_ID=
FIGMA_CLIENT_SECRET=

# LinkedIn — https://www.linkedin.com/developers/apps
# Redirect: ${PUBLIC_APP_URL}/api/connect/linkedin/callback
# Scopes: openid, profile, email, w_member_social
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Microsoft — https://entra.microsoft.com/ (App registrations)
# Redirect: ${PUBLIC_APP_URL}/api/connect/microsoft/callback
# Scopes: openid, email, profile, offline_access, Mail.ReadWrite, Calendars.ReadWrite
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# HubSpot — https://developers.hubspot.com/ (Public App)
# Redirect: ${PUBLIC_APP_URL}/api/connect/hubspot/callback
# Scopes: crm.objects.contacts.read, crm.objects.contacts.write, crm.objects.deals.read
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
